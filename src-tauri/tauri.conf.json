{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nearly",
  "mainBinaryName": "Nearly",
  "version": "0.2.0",
  "identifier": "local.syncfiles.native",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nearly",
        "width": 1180,
        "height": 850,
        "minWidth": 800,
        "minHeight": 650,
        "decorations": false,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
